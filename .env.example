# Copy to .env in the project root. Local defaults; do not commit secrets.
# Shell/Azure environment variables take precedence over this file.

# Backend when running directly with npm run dev/start.
# Leave NODE_ENV out of this shared file: Vite selects development/production
# for its commands. Docker and Azure set NODE_ENV=production at runtime.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/wolfchatter
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Docker Compose: MongoDB is reached by its container service name.
# The app container runs NODE_ENV=production and uses PORT above.
DOCKER_MONGODB_URI=mongodb://mongodb:27017/wolfchatter
MONGODB_HOST_PORT=27018

# Vite development server only. VITE_* values are public; never put secrets here.
DEV_FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional integration-test targets (test:unread creates a temporary database).
TEST_API_URL=http://127.0.0.1:3000
TEST_MONGODB_BASE=mongodb://127.0.0.1:27018

# If ports change, also update the corresponding URLs and ALLOWED_ORIGINS.
# Azure production: set NODE_ENV=production, COOKIE_SECURE=true,
# MONGODB_URI to the Atlas connection string, and ALLOWED_ORIGINS to the
# exact HTTPS app origin(s). Docker/dev/test settings are not needed on Azure.
